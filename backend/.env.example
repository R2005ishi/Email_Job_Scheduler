# ---------- Server ----------
PORT=4000
# Where the React app runs (used for OAuth redirects + CORS)
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used to build OAuth callback URLs)
BACKEND_URL=http://localhost:4000
# Any long random string - signs the session cookie / OAuth state
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Infra ----------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/email_scheduler?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Google OAuth (required) ----------
# Authorized redirect URI in Google Cloud console must be: ${BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Slack OAuth (required for rate-limit notifications) ----------
# Redirect URL in the Slack app must be: ${SLACK_REDIRECT_BASE_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack only accepts HTTPS redirect URLs - point this at an https tunnel (e.g. ngrok) to the backend.
# Defaults to BACKEND_URL when empty.
SLACK_REDIRECT_BASE_URL=

# ---------- Ethereal SMTP senders ----------
# Optional JSON array of existing Ethereal accounts: [{"user":"x@ethereal.email","pass":"...","name":"Sales"}]
# If empty, the server creates ETHEREAL_SENDER_COUNT fresh Ethereal accounts on first boot and stores them in Postgres.
ETHEREAL_ACCOUNTS=
ETHEREAL_SENDER_COUNT=3

# ---------- Scheduler / throughput ----------
# How many jobs one worker process runs in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hourly cap per sender (applies across all users/campaigns using that sender)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Retries for SMTP failures before an email is marked FAILED
EMAIL_SEND_ATTEMPTS=3

# ---------- Bull Board ----------
# Optional basic-auth for /admin/queues (leave empty to keep it open locally)
BULL_BOARD_USER=
BULL_BOARD_PASS=
